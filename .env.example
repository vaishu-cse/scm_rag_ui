# Where the browser posts. Relative on purpose: these resolve against whatever origin served
# the page, so one build works in every environment and there is no CORS to configure.
# Drop VITE_CHAT_API_URL to go back to the canned replies in src/mockReplies.js.
VITE_CHAT_API_URL=/api/chat

# Feeds documents into the knowledge base. Drop it and the upload control disappears.
VITE_UPLOAD_API_URL=/api/documents/upload

# Dev only. Vite proxies /api here, standing in for the gateway that does it in production.
# A local backend or a tunnel both work; ngrok URLs change each time the tunnel restarts.
VITE_API_TARGET=http://localhost:8000

# Build only, and only if the gateway serves the UI somewhere other than the root.
# PUBLIC_BASE=/chat/
